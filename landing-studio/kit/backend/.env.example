# Copiază fișierul ăsta ca .env.local (local) și adaugă aceleași variabile în Vercel
# (Settings > Environment Variables). Nu pune niciodată parola în repo.

# --- Trimiterea e-mailului (SMTP) ---
# Gmail: smtp.gmail.com, port 587, parolă de aplicație (Cont Google > Securitate > Parole de aplicații).
# Parola de aplicație are 16 litere; scrie-o fără spații.
# Hostinger: smtp.hostinger.com, port 465.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=adresa@domeniul-tau.ro
SMTP_PASS=parola-de-aplicatie-fara-spatii
# Implicit: securizat (SSL) doar pe portul 465. Setează "true" sau "false" doar dacă ai nevoie.
# SMTP_SECURE=false
# Cum apare expeditorul la destinatar
MAIL_FROM="Ana Exemplu <adresa@domeniul-tau.ro>"

# --- Unde primești tu fiecare contact nou (recomandat; pe Vercel e singura copie sigură) ---
LEADS_NOTIFY_TO=adresa-ta@domeniul-tau.ro

# --- Adresa publică a paginii, fără slash la final. Fără ea, butonul de descărcare dispare. ---
# SITE_URL=https://domeniul-tau.ro

# --- Atașamente ---
# Folderul ale cărui fișiere pleacă atașate (implicit: agenti/). Fișierele ascunse și CITESTE.txt sunt ignorate.
# ATTACH_DIR=agenti
# Alternativ: un link în loc de atașamente
# ATTACH_URL=https://...

# --- Unde se salvează contactele pe server (opțional) ---
# Implicit: data/leads.jsonl. Pe Vercel discul e doar pentru citire, deci salvarea eșuează și e normal.
# LEADS_FILE=/cale/absoluta/leads.jsonl
